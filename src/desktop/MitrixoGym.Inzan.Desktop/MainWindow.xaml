<Window x:Class="MitrixoGym.Inzan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MitrixoGym.Desktop.Core.ViewModels;assembly=MitrixoGym.Desktop.Core"
        mc:Ignorable="d"
        Title="INZAN ATHLETICS CRM — Windows Desktop"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#09090B"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Reusable Glass Card Style -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Modern Button Style (Crimson Accent) -->
        <Style x:Key="CrimsonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushInzanCrimson}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushInzanCrimsonHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#71717A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Glass Button Style -->
        <Style x:Key="SecondaryGlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCardElevated}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushCardHover}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#3F3F46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Button Base Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Layout Grid: Top Bar & Content Area -->
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />  <!-- Top Header & Browser / Mode Switcher -->
            <RowDefinition Height="*" />   <!-- Content Container -->
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- ROW 0: TOP BRANDED HEADER & BROWSER CONTROLS              -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#0C0C0F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Inzan Logo + Brand + Browser Nav Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="INZAN" FontWeight="Black" FontSize="15" Foreground="{StaticResource BrushInzanCrimson}" />
                            <TextBlock Text=" ATHLETICS" FontWeight="Bold" FontSize="15" Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Web Browser Controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="NavBack_Click" ToolTip="Go Back" Padding="7,4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Foreground="{StaticResource BrushTextPrimary}" Cursor="Hand" Margin="0,0,4,0">
                            <TextBlock Text="◀" FontSize="11" />
                        </Button>
                        <Button Click="NavForward_Click" ToolTip="Go Forward" Padding="7,4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Foreground="{StaticResource BrushTextPrimary}" Cursor="Hand" Margin="0,0,4,0">
                            <TextBlock Text="▶" FontSize="11" />
                        </Button>
                        <Button Click="NavReload_Click" ToolTip="Reload" Padding="7,4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Foreground="{StaticResource BrushTextPrimary}" Cursor="Hand" Margin="0,0,4,0">
                            <TextBlock Text="🔄" FontSize="11" />
                        </Button>
                        <Button Click="NavHome_Click" ToolTip="Home (inzanathletics.mitrixo.com)" Padding="7,4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Foreground="{StaticResource BrushTextPrimary}" Cursor="Hand" Margin="0,0,12,0">
                            <TextBlock Text="🏠" FontSize="11" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Mode Switcher (Web CRM vs Offline Reception Desk) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#141419" CornerRadius="9" Padding="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <!-- Full Web CRM Button -->
                            <Button Command="{Binding SwitchToWebCrmCommand}" Padding="14,5" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWebCrmMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushInzanCrimson}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 " FontSize="12" />
                                    <TextBlock Text="Full Web CRM (inzanathletics.mitrixo.com)" />
                                </StackPanel>
                            </Button>

                            <!-- Offline Reception Desk Button -->
                            <Button Command="{Binding SwitchToOfflineReceptionCommand}" Padding="14,5" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWebCrmMode}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource BrushInzanCrimson}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="12" />
                                    <TextBlock Text="Offline Reception Desk" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Online/Offline, Outbox Drawer, Fullscreen, Lock -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Online / Offline Pill -->
                    <Border Background="#141419" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{Binding SyncStatus.IsOnline, Converter={StaticResource StatusToBrush}}" />
                            <TextBlock Text="Online" Visibility="{Binding SyncStatus.IsOnline, Converter={StaticResource BoolToVis}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                            <TextBlock Text="Offline" Visibility="{Binding SyncStatus.IsOnline, Converter={StaticResource InverseBoolToVis}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Outbox Drawer Button -->
                    <Button Command="{Binding ToggleOutboxDrawerCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryGlassButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦 Outbox" FontSize="11" FontWeight="SemiBold" />
                            <Border Background="{StaticResource BrushInzanCrimson}" CornerRadius="7" Padding="5,1" Margin="6,0,0,0"
                                    Visibility="{Binding OutboxInspector.PendingCount, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding OutboxInspector.PendingCount}" FontSize="9" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Fullscreen Toggle -->
                    <Button Click="ToggleFullscreen_Click" ToolTip="Toggle Fullscreen" Margin="0,0,8,0" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="7,4">
                        <TextBlock Text="⛶" FontSize="11" />
                    </Button>

                    <!-- Fast Lock Button -->
                    <Button Command="{Binding FastLockCommand}" Padding="10,5" Background="#261217" BorderBrush="{StaticResource BrushInzanCrimson}" BorderThickness="1" Foreground="{StaticResource BrushInzanCrimsonLight}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔒 Lock" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 1: MAIN CONTENT AREA                                  -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <!-- VIEW A: FULL WEB CRM (Microsoft Edge WebView2) -->
            <wv2:WebView2 x:Name="CrmWebView"
                          Visibility="{Binding IsWebCrmMode, Converter={StaticResource BoolToVis}}" />

            <!-- VIEW B: OFFLINE MODERN CRM WORKSPACE -->
            <Grid Visibility="{Binding IsOfflineReceptionMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" /> <!-- Left Navigation Sidebar -->
                    <ColumnDefinition Width="*" />   <!-- Main Content Area with 6 Tabs -->
                </Grid.ColumnDefinitions>

                <!-- ===================================================== -->
                <!-- LEFT NAVIGATION SIDEBAR (Matching inzanathletics web) -->
                <!-- ===================================================== -->
                <Border Grid.Column="0" Background="#0C0C10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Sidebar Brand Header -->
                            <RowDefinition Height="*" />    <!-- Navigation Menu Items -->
                            <RowDefinition Height="Auto" /> <!-- Sidebar Footer Status -->
                        </Grid.RowDefinitions>

                        <!-- Sidebar Brand Header -->
                        <Border Grid.Row="0" Padding="18,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="#16161D" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0">
                                        <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="INZAN" FontWeight="Black" FontSize="15" Foreground="{StaticResource BrushInzanCrimson}" />
                                            <TextBlock Text=" ATHLETICS" FontWeight="Bold" FontSize="15" Foreground="White" />
                                        </StackPanel>
                                        <TextBlock Text="OFFLINE RECEPTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Navigation Menu Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,14">
                            <StackPanel>
                                <TextBlock Text="MANAGEMENT MODULES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,10" />

                                <!-- 1. Dashboard Tab Button -->
                                <Button Command="{Binding SetTabCommand}" CommandParameter="dashboard" Style="{StaticResource SidebarNavButtonStyle}">
                                    <Border CornerRadius="10" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDashboardTab}" Value="True">
                                                        <Setter Property="Background" Value="#251217" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📊" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Dashboard" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDashboardTab}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- 2. Clients Directory Tab Button (with TotalMembersCount Badge) -->
                                <Button Command="{Binding SetTabCommand}" CommandParameter="clients" Style="{StaticResource SidebarNavButtonStyle}">
                                    <Border CornerRadius="10" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClientsTab}" Value="True">
                                                        <Setter Property="Background" Value="#251217" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="👥" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Clients Directory" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsClientsTab}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Total Members Badge -->
                                            <Border Grid.Column="2" Background="#181820" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                                <TextBlock Text="{Binding TotalMembersCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- 3. Attendance Kiosk Tab Button -->
                                <Button Command="{Binding SetTabCommand}" CommandParameter="attendance" Style="{StaticResource SidebarNavButtonStyle}">
                                    <Border CornerRadius="10" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAttendanceTab}" Value="True">
                                                        <Setter Property="Background" Value="#251217" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚡" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Attendance Kiosk" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAttendanceTab}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- 4. Payments & POS Tab Button -->
                                <Button Command="{Binding SetTabCommand}" CommandParameter="payments" Style="{StaticResource SidebarNavButtonStyle}">
                                    <Border CornerRadius="10" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaymentsTab}" Value="True">
                                                        <Setter Property="Background" Value="#251217" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="💳" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Payments &amp; POS" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaymentsTab}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- 5. Class Schedule Tab Button -->
                                <Button Command="{Binding SetTabCommand}" CommandParameter="schedule" Style="{StaticResource SidebarNavButtonStyle}">
                                    <Border CornerRadius="10" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScheduleTab}" Value="True">
                                                        <Setter Property="Background" Value="#251217" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📅" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Class Schedule" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsScheduleTab}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- 6. Outbox Sync Queue Button (with PendingCount Badge) -->
                                <Button Command="{Binding SetTabCommand}" CommandParameter="outbox" Style="{StaticResource SidebarNavButtonStyle}">
                                    <Border CornerRadius="10" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutboxTab}" Value="True">
                                                        <Setter Property="Background" Value="#251217" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📦" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Outbox Sync" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutboxTab}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Pending Mutations Badge -->
                                            <Border Grid.Column="2" Background="{StaticResource BrushInzanCrimson}" CornerRadius="8" Padding="6,2"
                                                    Visibility="{Binding OutboxInspector.PendingCount, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding OutboxInspector.PendingCount}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sidebar Footer Status -->
                        <Border Grid.Row="2" Padding="14,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Background="#09090C">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentReceptionist}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Desk Receptionist" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding FastLockCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Lock Terminal" Padding="4">
                                        <TextBlock Text="🔒" FontSize="12" Foreground="{StaticResource BrushInzanCrimsonLight}" />
                                    </Button>
                                </Grid>

                                <Border Background="#141419" CornerRadius="6" Padding="8,4" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SQLite WAL • Synced" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{Binding SyncStatus.IsOnline, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===================================================== -->
                <!-- MAIN WORKSPACE CONTENT CONTAINER (Right side)         -->
                <!-- ===================================================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" /> <!-- Section Status & Sync Banner -->
                        <RowDefinition Height="*" />  <!-- Tab Views -->
                        <RowDefinition Height="30" /> <!-- Workspace Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header Status & Sync Banner -->
                    <Border Grid.Row="0" Background="#0F0F14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,12,0"
                                        Background="{Binding SyncStatus.SyncPillState, Converter={StaticResource SyncStatusToBrush}}">
                                    <TextBlock Text="{Binding SyncStatus.SyncPillText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="Last synced: " FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding SyncStatus.LastSyncDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>

                            <!-- Center Status / Feedback Note -->
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource BrushInzanCrimsonLight}" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="20,0" />

                            <!-- Sync Now Action -->
                            <Button Grid.Column="2" Command="{Binding SyncStatus.SyncNowCommand}" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="10" />
                                    <TextBlock Text="Sync Now" FontSize="10" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ================================================= -->
                    <!-- TAB 1 - DASHBOARD VIEW                            -->
                    <!-- ================================================= -->
                    <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 5 KPI Glass Cards -->
                            <RowDefinition Height="Auto" /> <!-- Quick Barcode/ID Check-In Box -->
                            <RowDefinition Height="*" />    <!-- 2 Columns: Check-in Stream & Payments Stream -->
                        </Grid.RowDefinitions>

                        <!-- Top 5 Frosted Glass KPI Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- KPI 1: Total Members -->
                            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="TOTAL ATHLETES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="👥" FontSize="14" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding TotalMembersCount}" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2" />
                                    <TextBlock Text="Registered Roster" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 2: Active Members -->
                            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ACTIVE MEMBERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ActiveMembersCount}" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushSuccess}" Margin="0,6,0,2" />
                                    <TextBlock Text="Valid Memberships" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 3: Expired / Leads -->
                            <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="EXPIRED / LEADS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="⚠️" FontSize="14" HorizontalAlignment="Right" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                        <TextBlock Text="{Binding ExpiredMembersCount}" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushDanger}" />
                                        <TextBlock Text=" / " FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LeadsCount}" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushWarning}" />
                                    </StackPanel>
                                    <TextBlock Text="Requires Renewal" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 4: Today's Check-ins -->
                            <Border Grid.Column="6" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="TODAY'S CHECK-INS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="🎯" FontSize="14" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding TodayCheckInCount}" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushInzanCrimsonLight}" Margin="0,6,0,2" />
                                    <TextBlock Text="Club Attendance" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI 5: Today's Revenue -->
                            <Border Grid.Column="8" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="TODAY'S REVENUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="💳" FontSize="14" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding TodayRevenue, StringFormat='{}{0:N0} EGP'}" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushInzanGold}" Margin="0,6,0,2" />
                                    <TextBlock Text="Offline POS Sales" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Barcode/ID Check-In Box -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="18,14" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorderTranslucent}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource BrushInzanCrimson}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="QUICK ATHLETE CHECK-IN" FontSize="13" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Quick Barcode / ID Input -->
                                    <Border Grid.Column="1" Background="#09090C" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12,6" Margin="0,0,14,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox x:Name="QuickScannerBox" Grid.Column="1" Text="{Binding KioskScannerText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="14" Background="Transparent" Foreground="White" BorderThickness="0"
                                                     CaretBrush="{StaticResource BrushInzanCrimson}" VerticalAlignment="Center"
                                                     KeyDown="QuickScannerBox_KeyDown">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                                            <VisualBrush.Visual>
                                                                                <TextBlock Text="Scan barcode, enter Member Code (e.g. INZ-001) or phone number..." Foreground="{StaticResource BrushTextMuted}" FontSize="13" FontStyle="Italic" />
                                                                            </VisualBrush.Visual>
                                                                        </VisualBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </Border>

                                    <!-- Action Button -->
                                    <Button Grid.Column="2" Command="{Binding ProcessKioskScanCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ Check In" FontSize="12" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Kiosk Verdict Banner on Dashboard -->
                                <Border Grid.Row="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                        Visibility="{Binding HasKioskVerdict, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#351218" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKioskApproved}" Value="True">
                                                    <Setter Property="Background" Value="#0C3424" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding KioskVerdictMessage}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Command="{Binding DismissKioskVerdictCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Two Columns: Today's Check-in Feed & Recent Payments Stream -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Today's Check-in Live Feed -->
                            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯 " FontSize="14" />
                                            <TextBlock Text="TODAY'S CHECK-IN STREAM" FontSize="12" FontWeight="Black" Foreground="White" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#16161F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                            <TextBlock Text="{Binding TodayCheckInCount, StringFormat='{}{0} Logged'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" />
                                        </Border>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RecentCheckIns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0C0C10" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="✓ " FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ClientName}" FontWeight="Bold" FontSize="13" Foreground="White" />
                                                                <TextBlock Text="{Binding PackageName, FallbackValue='General Admission'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DateUtc, StringFormat='{}{0:HH:mm}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding RecordedByUserId}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" FontStyle="Italic" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Column 2: Recent Payments Stream -->
                            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💳 " FontSize="14" />
                                            <TextBlock Text="RECENT PAYMENTS STREAM" FontSize="12" FontWeight="Black" Foreground="White" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#16161F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                            <TextBlock Text="{Binding TodayRevenue, StringFormat='{}{0:N0} EGP'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushInzanGold}" />
                                        </Border>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RecentPayments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0C0C10" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ClientName, FallbackValue='Walk-in Guest'}" FontWeight="Bold" FontSize="13" Foreground="White" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding PackageName}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" />
                                                                    <Border Background="#1F1A24" CornerRadius="4" Padding="5,1">
                                                                        <TextBlock Text="{Binding PaymentMethod}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} EGP'}" FontSize="13" FontWeight="Black" Foreground="{StaticResource BrushInzanGold}" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding DateUtc, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- TAB 2 - CLIENTS DIRECTORY VIEW                    -->
                    <!-- ================================================= -->
                    <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsClientsTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Search & Status Filter Pills -->
                            <RowDefinition Height="*" />    <!-- Member List + Right Detail Drawer -->
                        </Grid.RowDefinitions>

                        <!-- Search & Filter Controls -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="380" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Search Input Bar -->
                                <Border Grid.Column="0" Background="#09090C" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" Background="Transparent" Foreground="White" BorderThickness="0"
                                                 VerticalAlignment="Center" CaretBrush="{StaticResource BrushInzanCrimson}"
                                                 KeyDown="SearchBox_KeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                                        <VisualBrush.Visual>
                                                                            <TextBlock Text="Search name, phone, or athlete ID..." Foreground="{StaticResource BrushTextMuted}" FontSize="13" FontStyle="Italic" />
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                                Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                        </Button>
                                        <Button Grid.Column="3" Command="{Binding SearchCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="10,4" Margin="6,0,0,0">
                                            <TextBlock Text="Search" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Status Filter Pills -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="FILTER:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Filter: All -->
                                    <Button Command="{Binding FilterStatusCommand}" CommandParameter="All" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,8,0" Padding="12,5">
                                        <TextBlock Text="{Binding TotalMembersCount, StringFormat='All ({0})'}" FontSize="11" />
                                    </Button>

                                    <!-- Filter: Active -->
                                    <Button Command="{Binding FilterStatusCommand}" CommandParameter="Active" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,8,0" Padding="12,5">
                                        <TextBlock Text="{Binding ActiveMembersCount, StringFormat='Active ({0})'}" FontSize="11" Foreground="{StaticResource BrushSuccess}" FontWeight="Bold" />
                                    </Button>

                                    <!-- Filter: Expired -->
                                    <Button Command="{Binding FilterStatusCommand}" CommandParameter="Expired" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,8,0" Padding="12,5">
                                        <TextBlock Text="{Binding ExpiredMembersCount, StringFormat='Expired ({0})'}" FontSize="11" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" />
                                    </Button>

                                    <!-- Filter: Leads -->
                                    <Button Command="{Binding FilterStatusCommand}" CommandParameter="Lead" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="12,5">
                                        <TextBlock Text="{Binding LeadsCount, StringFormat='Leads ({0})'}" FontSize="11" Foreground="{StaticResource BrushWarning}" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Content: Member Listing + Member Detail Drawer -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="380" /> <!-- Right Detail Drawer -->
                            </Grid.ColumnDefinitions>

                            <!-- Member Listing Cards/Table -->
                            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Table Column Headers -->
                                    <Grid Grid.Row="0" Margin="12,0,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" /> <!-- Name & Contact -->
                                            <ColumnDefinition Width="100" /> <!-- Member Code -->
                                            <ColumnDefinition Width="*" />   <!-- Package -->
                                            <ColumnDefinition Width="90" />  <!-- Sessions -->
                                            <ColumnDefinition Width="110" /> <!-- Expiry -->
                                            <ColumnDefinition Width="80" />  <!-- Status -->
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ATHLETE NAME &amp; PHONE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="MEMBER CODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="2" Text="PACKAGE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="3" Text="SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="4" Text="EXPIRY DATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="5" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Member Rows List -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0C0C10" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"
                                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                                                            MouseLeftButtonUp="MemberRow_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushInzanCrimson}" />
                                                                        <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="80" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Name & Phone -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <!-- Member Code -->
                                                            <TextBlock Grid.Column="1" Text="{Binding MemberCode}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushInzanGold}" VerticalAlignment="Center" />

                                                            <!-- Package -->
                                                            <TextBlock Grid.Column="2" Text="{Binding PackageType, FallbackValue='General Admission'}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                            <!-- Sessions Remaining -->
                                                            <TextBlock Grid.Column="3" Text="{Binding SessionsRemaining, FallbackValue='Unlimited'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />

                                                            <!-- Expiry Date -->
                                                            <TextBlock Grid.Column="4" Text="{Binding MembershipExpiry, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />

                                                            <!-- Status Badge -->
                                                            <Border Grid.Column="5" Background="{Binding Status, Converter={StaticResource StatusToBrush}}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Right: Member Detail Drawer -->
                            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="20">
                                <Grid>
                                    <!-- Empty Placeholder when no member selected -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedMember, Converter={StaticResource InverseNullToVis}}">
                                        <TextBlock Text="👤" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                        <TextBlock Text="Select an Athlete" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="Click any member row to view full profile, verify access, check in, or process payment." FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Detail View when member is selected -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedMember, Converter={StaticResource NullToVis}}">
                                        <StackPanel>
                                            <!-- Drawer Header with Close Button -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MEMBER PROFILE" FontSize="11" FontWeight="Black" Foreground="{StaticResource BrushInzanCrimson}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Click="CloseMemberDrawer_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                                                    <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource BrushTextMuted}" />
                                                </Button>
                                            </Grid>

                                            <!-- Avatar & Name Card -->
                                            <Border Background="#09090C" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,16">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="64" Height="64" CornerRadius="32" Background="#1C1316" BorderBrush="{StaticResource BrushInzanCrimson}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                        <TextBlock Text="◈" FontSize="26" Foreground="{StaticResource BrushInzanCrimsonLight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedMember.Name}" FontSize="18" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                                                        <TextBlock Text="ID: " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                        <TextBlock Text="{Binding SelectedMember.MemberCode}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushInzanGold}" Margin="0,0,10,0" />
                                                        <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                        <TextBlock Text="{Binding SelectedMember.Phone}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                                    </StackPanel>
                                                    <Border Background="{Binding SelectedMember.Status, Converter={StaticResource StatusToBrush}}" CornerRadius="6" Padding="12,3" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedMember.Status}" FontSize="11" FontWeight="Black" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Membership Details -->
                                            <Border Background="#09090C" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="MEMBERSHIP SUBSCRIPTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />

                                                    <TextBlock Text="Current Package:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                    <TextBlock Text="{Binding SelectedMember.PackageType, FallbackValue='Standard Membership'}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,8" />

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Remaining Sessions:" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding SelectedMember.SessionsRemaining, FallbackValue='Unlimited'}" FontSize="16" FontWeight="Black" Foreground="{StaticResource BrushSuccess}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="PT Sessions:" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding SelectedMember.PtSessionsRemaining, FallbackValue='0'}" FontSize="16" FontWeight="Black" Foreground="{StaticResource BrushInzanGold}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="Expiry Date:" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                                    <TextBlock Text="{Binding SelectedMember.MembershipExpiry, StringFormat='{}{0:MMMM dd, yyyy}'}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,8" />

                                                    <TextBlock Text="Facility Branch:" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                                    <TextBlock Text="{Binding SelectedMember.BranchId, FallbackValue='Garden 8 - New Cairo'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Quick Actions Buttons -->
                                            <StackPanel>
                                                <!-- 1-Click Check-In -->
                                                <Button Command="{Binding QuickCheckInCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="0,12" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="⚡ 1-Click Athlete Check-In" FontSize="13" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Record Payment -->
                                                <Button Click="SwitchToPaymentsForMember_Click" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="0,10">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="💳 Record Payment &amp; Renewal" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- TAB 3 - ATTENDANCE KIOSK VIEW                     -->
                    <!-- ================================================= -->
                    <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsAttendanceTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Giant Scanner Panel & Verdict Banner -->
                            <RowDefinition Height="*" />    <!-- Today's Verified Log -->
                        </Grid.RowDefinitions>

                        <!-- Reception Scanner Terminal -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="28,24" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " FontSize="20" Foreground="{StaticResource BrushInzanCrimson}" />
                                            <TextBlock Text="RECEPTION SCANNER &amp; TURNSTILE KIOSK" FontSize="16" FontWeight="Black" Foreground="White" />
                                        </StackPanel>
                                        <TextBlock Text="Barcode scanner auto-verifies and registers attendance upon Enter." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Giant Scanner Input Box -->
                                <Border Background="#09090C" CornerRadius="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" Padding="16,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📷" FontSize="24" Foreground="{StaticResource BrushInzanCrimson}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBox x:Name="KioskScannerBox" Grid.Column="1" Text="{Binding KioskScannerText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="20" FontWeight="Bold" Background="Transparent" Foreground="White" BorderThickness="0"
                                                 CaretBrush="{StaticResource BrushInzanCrimson}" VerticalAlignment="Center"
                                                 KeyDown="KioskScannerBox_KeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                                        <VisualBrush.Visual>
                                                                            <TextBlock Text="Scan athlete pass or type Member Code / Phone and press ENTER..." Foreground="{StaticResource BrushTextMuted}" FontSize="16" FontStyle="Italic" />
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        <Button Grid.Column="2" Command="{Binding ProcessKioskScanCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="20,10">
                                            <TextBlock Text="VERIFY &amp; CHECK IN" FontSize="13" FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Prominent Verdict Banner (Approved / Rejected) -->
                                <Border CornerRadius="12" Padding="20,14"
                                        Visibility="{Binding HasKioskVerdict, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#351218" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKioskApproved}" Value="True">
                                                    <Setter Property="Background" Value="#0C3424" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✕" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKioskApproved}" Value="True">
                                                            <Setter Property="Text" Value="✓" />
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KioskVerdictMessage}" FontSize="15" FontWeight="Black" Foreground="White" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding DismissKioskVerdictCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                                            <TextBlock Text="Dismiss" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Today's Attendance Verified Log -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TODAY'S VERIFIED CHECK-IN LOG" FontSize="12" FontWeight="Black" Foreground="White" />
                                    <TextBlock Grid.Column="1" Text="{Binding TodayCheckInCount, StringFormat='Total Checked In: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentCheckIns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0C0C10" CornerRadius="8" Padding="14,10" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="✓" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ClientName}" FontSize="14" FontWeight="Bold" Foreground="White" />
                                                            <TextBlock Text="{Binding PackageName, FallbackValue='General Pass'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RecordedByUserId, StringFormat='Staff: {0}'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding BranchId, StringFormat='Studio: {0}'}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding DateUtc, StringFormat='{}{0:HH:mm:ss}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushInzanGold}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- TAB 4 - PAYMENTS & POS VIEW                       -->
                    <!-- ================================================= -->
                    <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsPaymentsTab, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520" /> <!-- POS Form -->
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />   <!-- Recent Payments & Summary -->
                        </Grid.ColumnDefinitions>

                        <!-- POS Form Card -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="OFFLINE POS BILLING TERMINAL" FontSize="13" FontWeight="Black" Foreground="{StaticResource BrushInzanCrimson}" Margin="0,0,0,14" />

                                    <!-- Selected Member Banner -->
                                    <Border Background="#09090C" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="PAYER / ATHLETE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding SelectedMember.Name, FallbackValue='Walk-in Guest / Quick Sale'}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding SelectedMember.Phone, FallbackValue='No phone registered'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding ClearSearchCommand}" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="Reset" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Package Selection Pills -->
                                    <TextBlock Text="SELECT MEMBERSHIP / PASS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Command="{Binding SelectPosPackageCommand}" CommandParameter="1 Month Boxing Membership" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                            <TextBlock Text="1 Month (1,500 EGP)" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding SelectPosPackageCommand}" CommandParameter="3 Months All-Access" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                            <TextBlock Text="3 Months (3,800 EGP)" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding SelectPosPackageCommand}" CommandParameter="10 Sessions Pass" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                            <TextBlock Text="10 Sessions (1,200 EGP)" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding SelectPosPackageCommand}" CommandParameter="Personal Training (PT Pack)" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                            <TextBlock Text="PT Pack (3,000 EGP)" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding SelectPosPackageCommand}" CommandParameter="Day Pass" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,6" Padding="10,5">
                                            <TextBlock Text="Day Pass (200 EGP)" FontSize="11" />
                                        </Button>
                                    </WrapPanel>

                                    <!-- Current Package Text -->
                                    <Border Background="#09090C" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10,6" Margin="0,0,0,14">
                                        <TextBox Text="{Binding PosPackage, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="{StaticResource BrushInzanCrimson}" />
                                    </Border>

                                    <!-- Amount (EGP) -->
                                    <TextBlock Text="AMOUNT (EGP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <Border Background="#09090C" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10,6" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding PosAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Black" Background="Transparent" Foreground="{StaticResource BrushInzanGold}" BorderThickness="0" CaretBrush="{StaticResource BrushInzanCrimson}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="EGP" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Payment Method Pills -->
                                    <TextBlock Text="PAYMENT METHOD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding SelectPosMethodCommand}" CommandParameter="Cash" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="6,6">
                                            <TextBlock Text="💵 Cash" FontSize="11" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding SelectPosMethodCommand}" CommandParameter="Credit Card" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="6,6">
                                            <TextBlock Text="💳 Card" FontSize="11" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="4" Command="{Binding SelectPosMethodCommand}" CommandParameter="Instapay" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="6,6">
                                            <TextBlock Text="⚡ Instapay" FontSize="11" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="6" Command="{Binding SelectPosMethodCommand}" CommandParameter="Bank Transfer" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="6,6">
                                            <TextBlock Text="🏦 Transfer" FontSize="11" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <!-- Selected Method Display -->
                                    <TextBlock Text="{Binding PosMethod, StringFormat='Selected Method: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" Margin="0,0,0,14" />

                                    <!-- Notes -->
                                    <TextBlock Text="RECEIPT &amp; TRANSACTION NOTES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                                    <Border Background="#09090C" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10,8" Margin="0,0,0,16">
                                        <TextBox Text="{Binding PosNotes, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="Transparent" Foreground="White" BorderThickness="0" Height="46" TextWrapping="Wrap" AcceptsReturn="True" CaretBrush="{StaticResource BrushInzanCrimson}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                                        <VisualBrush.Visual>
                                                                            <TextBlock Text="Enter reference #, transfer details, or cashier notes..." Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontStyle="Italic" />
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                    </Border>

                                    <!-- Submit Payment Button -->
                                    <Button Command="{Binding RecordPaymentCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="0,14" Margin="0,0,0,12">
                                        <TextBlock Text="RECORD OFFLINE PAYMENT" FontSize="13" FontWeight="Black" />
                                    </Button>

                                    <!-- Immediate Receipt Confirmation Toast -->
                                    <Border CornerRadius="8" Padding="14,10" Background="#0C3424" BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1"
                                            Visibility="{Binding HasPosSuccess, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PosSuccessMessage}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Command="{Binding DismissPosSuccessCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                                                <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Column: Today's Revenue Summary & Payments History -->
                        <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LOCAL PAYMENTS JOURNAL" FontSize="13" FontWeight="Black" Foreground="White" />
                                        <TextBlock Text="Offline-collected revenue queued for synchronization." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#16161F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Total Today: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TodayRevenue, StringFormat='{}{0:N0} EGP'}" FontSize="15" FontWeight="Black" Foreground="{StaticResource BrushInzanGold}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentPayments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0C0C10" CornerRadius="8" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding ClientName, FallbackValue='Walk-in Guest'}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                                            <TextBlock Text="{Binding PackageName}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" FontStyle="Italic" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} EGP'}" FontSize="15" FontWeight="Black" Foreground="{StaticResource BrushInzanGold}" HorizontalAlignment="Right" />
                                                            <Border Background="#1F1A24" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding PaymentMethod}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DateUtc, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- TAB 5 - CLASS SCHEDULE VIEW                       -->
                    <!-- ================================================= -->
                    <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsScheduleTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Day Filter Pills -->
                            <RowDefinition Height="*" />    <!-- Timetable Cards -->
                        </Grid.RowDefinitions>

                        <!-- Day Filter Pills -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DAY:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="All" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="All Days" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Sunday" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Sunday" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Monday" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Monday" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Tuesday" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Tuesday" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Wednesday" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Wednesday" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Thursday" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Thursday" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Friday" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                                    <TextBlock Text="Friday" FontSize="11" />
                                </Button>
                                <Button Command="{Binding FilterScheduleDayCommand}" CommandParameter="Saturday" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="12,5">
                                    <TextBlock Text="Saturday" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Timetable Cards Grid -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ClassSchedules}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0C0C10" CornerRadius="12" Padding="18" Margin="0,0,16,16" Width="360" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1" Background="#251217" BorderBrush="{StaticResource BrushInzanCrimson}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                            <TextBlock Text="{Binding DayOfWeek}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushInzanCrimsonLight}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Coach & Branch -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="Coach: " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                        <TextBlock Text="{Binding InstructorName, FallbackValue='Coach Akram'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,12,0" />
                                                        <TextBlock Text="Studio: " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                        <TextBlock Text="{Binding Branch, FallbackValue='Garden 8'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                                    </StackPanel>

                                                    <!-- Time & Capacity -->
                                                    <Border Background="#141419" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="⏰ " FontSize="12" />
                                                                <TextBlock Text="{Binding StartTime}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                                                <TextBlock Text=" - " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding EndTime}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Capacity, StringFormat='Cap: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ================================================= -->
                    <!-- TAB 6 - OUTBOX & SYNC MANAGER VIEW                -->
                    <!-- ================================================= -->
                    <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsOutboxTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Queue Header & Actions -->
                            <RowDefinition Height="*" />    <!-- Operations List -->
                        </Grid.RowDefinitions>

                        <!-- Queue Header & Action Bar -->
                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="OUTBOX TRANSACTION SYNCHRONIZATION QUEUE" FontSize="13" FontWeight="Black" Foreground="{StaticResource BrushInzanCrimson}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Pending Mutations: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding OutboxInspector.PendingCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" Margin="0,0,16,0" />
                                        <TextBlock Text="Failed Operations: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding OutboxInspector.FailedCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" Margin="0,0,16,0" />
                                        <TextBlock Text="Conflicts: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding OutboxInspector.ConflictCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushInzanGold}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding OutboxInspector.RefreshCommand}" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,8,0" Padding="12,6">
                                        <TextBlock Text="🔄 Refresh Queue" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding OutboxInspector.RetryAllFailedCommand}" Style="{StaticResource CrimsonButtonStyle}" Margin="0,0,8,0" Padding="12,6">
                                        <TextBlock Text="Retry All Failed" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding SyncStatus.SyncNowCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="14,6">
                                        <TextBlock Text="⚡ Sync Now" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Operations Viewer -->
                        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Failed Section -->
                                    <TextBlock Text="FAILED OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" Margin="0,0,0,8"
                                               Visibility="{Binding OutboxInspector.FailedOperations.Count, Converter={StaticResource NullToVis}}" />
                                    <ItemsControl ItemsSource="{Binding OutboxInspector.FailedOperations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#261014" CornerRadius="8" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding OperationType}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushDanger}" Margin="0,0,10,0" />
                                                                <TextBlock Text="{Binding EntityType}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Command="{Binding DataContext.OutboxInspector.RetryOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource CrimsonButtonStyle}" Padding="10,4">
                                                                <TextBlock Text="Retry" FontSize="10" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding LastErrorMessage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2" Text="{Binding OperationId}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pending Queue Section -->
                                    <TextBlock Text="PENDING MUTATION QUEUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" Margin="0,10,0,8" />
                                    <ItemsControl ItemsSource="{Binding OutboxInspector.PendingOperations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0C0C10" CornerRadius="8" Padding="14,10" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding OperationType}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding EntityType}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding OperationId}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#261A14" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="Queued" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Workspace Footer -->
                    <Border Grid.Row="2" Background="#0C0C0F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MitrixoGYM Inzan Athletics Offline Desk • High-Performance SQLite WAL Working Set • ISO 27001 Certified Isolation" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Grid.Column="1" Text="Tenant: inzanathletics • Target: db-inzanathletics • Protocol v1.4" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- OUTBOX & DIAGNOSTICS DRAWER OVERLAY                       -->
        <!-- ========================================================= -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsOutboxDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B3000000" MouseLeftButtonUp="DrawerBackdrop_Click" />

            <!-- Drawer Container (Right side) -->
            <Border HorizontalAlignment="Right" Width="520" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Drawer Header -->
                        <RowDefinition Height="Auto" /> <!-- Queue Actions -->
                        <RowDefinition Height="*" />    <!-- Operations List -->
                        <RowDefinition Height="Auto" /> <!-- Close Button -->
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📦 OUTBOX QUEUE &amp; DIAGNOSTICS" FontSize="16" FontWeight="Black" Foreground="{StaticResource BrushInzanCrimson}" />
                            <TextBlock Text="Mutations pending synchronization to db-inzanathletics." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ToggleOutboxDrawerCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource BrushTextMuted}" />
                        </Button>
                    </Grid>

                    <!-- Queue Actions & Status -->
                    <Border Grid.Row="1" Background="#09090C" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pending: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding OutboxInspector.PendingCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" Margin="0,0,12,0" />
                                    <TextBlock Text="Failed: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding OutboxInspector.FailedCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" Margin="0,0,12,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding OutboxInspector.RefreshCommand}" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,0,6,0" Padding="8,4">
                                    <TextBlock Text="🔄 Refresh" FontSize="11" />
                                </Button>
                                <Button Command="{Binding OutboxInspector.RetryAllFailedCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="8,4">
                                    <TextBlock Text="Retry All" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Operations List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Failed Section -->
                            <TextBlock Text="FAILED OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" Margin="0,0,0,6"
                                       Visibility="{Binding OutboxInspector.FailedOperations.Count, Converter={StaticResource NullToVis}}" />
                            <ItemsControl ItemsSource="{Binding OutboxInspector.FailedOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#261014" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OperationType}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushDanger}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding EntityType}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding DataContext.OutboxInspector.RetryOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource CrimsonButtonStyle}" Padding="6,2">
                                                        <TextBlock Text="Retry" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding LastErrorMessage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2" Text="{Binding OperationId}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pending Queue Section -->
                            <TextBlock Text="PENDING QUEUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" Margin="0,10,0,6" />
                            <ItemsControl ItemsSource="{Binding OutboxInspector.PendingOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0C0C10" CornerRadius="8" Padding="12" Margin="0,0,0,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OperationType}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding EntityType}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding OperationId}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#261A14" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Queued" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Close Drawer Button -->
                    <Button Grid.Row="3" Command="{Binding ToggleOutboxDrawerCommand}" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="0,14,0,0" Padding="0,10">
                        <TextBlock Text="Close Drawer" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- FAST LOCK SCREEN OVERLAY                                  -->
        <!-- ========================================================= -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <Border Background="#F209090B" />

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Style="{StaticResource GlassCardStyle}" Padding="32">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#251217" BorderBrush="{StaticResource BrushInzanCrimson}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="INZAN ATHLETICS RECEPTION" FontSize="15" FontWeight="Black" Foreground="{StaticResource BrushInzanCrimson}" HorizontalAlignment="Center" />
                    <TextBlock Text="Workstation is Locked" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CurrentReceptionist, StringFormat='Logged in as: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,22" />

                    <!-- PIN Input -->
                    <TextBlock Text="ENTER STAFF PIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="LockPinBox" PasswordChanged="LockPinBox_PasswordChanged" FontSize="20" Padding="10,8" Background="#09090C" Foreground="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" HorizontalContentAlignment="Center" Margin="0,0,0,12" KeyDown="LockPinBox_KeyDown" />

                    <!-- Unlock Error Message -->
                    <TextBlock Text="{Binding UnlockErrorMessage}" FontSize="11" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center" Margin="0,0,0,10"
                               Visibility="{Binding UnlockErrorMessage, Converter={StaticResource NullToVis}}" />

                    <!-- Unlock Button -->
                    <Button Command="{Binding UnlockCommand}" Style="{StaticResource CrimsonButtonStyle}" Padding="0,12" Margin="0,0,0,16">
                        <TextBlock Text="Unlock Workstation" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Button>

                    <!-- Switch Receptionist -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Switch Reception Staff:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SwitchStaffBox" FontSize="12" Padding="8,5" Background="#09090C" Foreground="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Click="SwitchStaff_Click" Style="{StaticResource SecondaryGlassButtonStyle}" Padding="12,5">
                                    <TextBlock Text="Switch" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>