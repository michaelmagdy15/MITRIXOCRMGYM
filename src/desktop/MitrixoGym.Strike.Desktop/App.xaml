<Application x:Class="MitrixoGym.Strike.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MitrixoGym.Strike.Desktop.Converters">
    <Application.Resources>
        <!-- Value Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
        <conv:MemberStatusToBrushConverter x:Key="StatusToBrush" />
        <conv:SyncStatusToBrushConverter x:Key="SyncStatusToBrush" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVis" />
        <conv:EqualityToVisibilityConverter x:Key="InverseEqualityToVis" Invert="True" />
        <conv:EqualityToBrushConverter x:Key="EqualityToBrush" />

        <!-- Strike Clean White / Off-White & Matte Black Theme (strike-egy.com) -->
        <SolidColorBrush x:Key="BrushBackgroundMain" Color="#F8F9FA" />
        <SolidColorBrush x:Key="BrushBackgroundDark" Color="#FFFFFF" />

        <!-- Strike Sidebar Colors -->
        <SolidColorBrush x:Key="BrushSidebar" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushSidebarBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BrushSidebarHover" Color="#F3F4F6" />
        <SolidColorBrush x:Key="BrushSidebarActive" Color="#000000" />
        <SolidColorBrush x:Key="BrushSidebarActiveText" Color="#FFFFFF" />

        <!-- Cards & Panels (White with subtle border #E5E7EB) -->
        <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushCardGlass" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushCardHover" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BrushCardInput" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#F3F4F6" />

        <!-- Strike Brand Accent Colors: Matte Black (#000000) & Emerald Green (#10B981) -->
        <SolidColorBrush x:Key="BrushStrikePrimary" Color="#000000" />
        <SolidColorBrush x:Key="BrushStrikePrimaryDark" Color="#111827" />
        <SolidColorBrush x:Key="BrushStrikePrimaryLight" Color="#374151" />
        <SolidColorBrush x:Key="BrushStrikeGreen" Color="#10B981" />
        <SolidColorBrush x:Key="BrushStrikeGreenSoft" Color="#ECFDF5" />
        <SolidColorBrush x:Key="BrushStrikeGreenBorder" Color="#A7F3D0" />

        <!-- Typography & Text Tokens -->
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="BrushTextFaint" Color="#D1D5DB" />

        <!-- Status & Badge Colors -->
        <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
        <SolidColorBrush x:Key="BrushSuccessSoft" Color="#ECFDF5" />
        <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
        <SolidColorBrush x:Key="BrushWarningSoft" Color="#FEF3C7" />
        <SolidColorBrush x:Key="BrushDanger" Color="#EF4444" />
        <SolidColorBrush x:Key="BrushDangerSoft" Color="#FEE2E2" />
        <SolidColorBrush x:Key="BrushInfo" Color="#3B82F6" />
        <SolidColorBrush x:Key="BrushInfoSoft" Color="#EFF6FF" />
    </Application.Resources>
</Application>
