rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isPlatformAdminEmail() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email in [
          'michaelmitry13@gmail.com',
          'magd.gallab@gmail.com',
          'strike.egyptt@gmail.com',
          'admin@strike.eg'
        ];
    }

    function hasStaffCustomClaim() {
      return request.auth != null
        && 'role' in request.auth.token
        && request.auth.token.role in [
          'admin', 'super_admin', 'crm_admin', 'sales_manager', 'manager', 'owner',
          'rep', 'sales_rep', 'coach', 'staff', 'sales', 'frontdesk', 'receptionist',
          'nutritionist', 'doctor', 'fitness_manager'
        ];
    }

    function hasStaffFirestoreRole() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in [
          'admin', 'super_admin', 'crm_admin', 'sales_manager', 'manager', 'owner',
          'rep', 'sales_rep', 'coach', 'staff', 'sales', 'frontdesk', 'receptionist',
          'nutritionist', 'doctor', 'fitness_manager'
        ];
    }

    function isStaffOrAdmin() {
      return isPlatformAdminEmail() || hasStaffCustomClaim() || hasStaffFirestoreRole();
    }

    // Staff of the tenant in the path.
    function isTenantStaff(tenantId) {
      return isStaffOrAdmin()
        && (!('tenantId' in request.auth.token) || request.auth.token.tenantId == tenantId || isPlatformAdminEmail());
    }

    // User avatars — each user can read/write their own avatar, or staff can manage
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && (request.auth.uid == userId || isStaffOrAdmin())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                   && (request.auth.uid == userId || isStaffOrAdmin());
    }

    // Member photos — readable and writeable by authenticated users (members updating own photo or staff)
    match /member_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Branding assets (logos, splash screens) — publicly readable, writeable by staff/admin/owner
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isStaffOrAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Storefront assets (hero slides, sections, offers)
    match /storefront/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffOrAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Corporate proof documents uploaded during payment creation
    match /corporate_proofs/{fileName} {
      allow read: if request.auth != null;
      allow write: if isStaffOrAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Member documents (IDs, contracts, medical reports) — tenant-scoped.
    match /tenants/{tenantId}/member_documents/{clientId}/{fileName} {
      allow get: if isTenantStaff(tenantId);
      allow list: if false;
      allow create, update: if isTenantStaff(tenantId)
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf'
                       || request.resource.contentType == 'application/msword'
                       || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow delete: if false;
    }

    // Master class profile images — tenant-scoped, images only.
    match /tenants/{tenantId}/master_classes/{fileName} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isTenantStaff(tenantId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Package images (Packages.tsx upload path) — images only, staff/admin/owner.
    match /packages/{fileName} {
      allow read: if true;
      allow create, update: if isStaffOrAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isStaffOrAdmin();
    }

    // Everything else is denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
