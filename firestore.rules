rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Returns the document from the users collection for the authenticated user
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      let data = getUserData();
      return data != null ? data.role : 'client';
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }
    
    function isCrmAdmin() {
      return isAuthenticated() && getUserRole() == 'crm_admin';
    }
    
    function isManager() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'manager' || role == 'super_admin' || role == 'crm_admin');
    }
    
    function isStaff() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'manager' || role == 'admin' || role == 'rep' || role == 'coach' || role == 'super_admin' || role == 'crm_admin');
    }
    
    function isCoach() {
      return isAuthenticated() && getUserRole() == 'coach';
    }
    
    function isClient() {
      let role = getUserRole();
      // If role is null or explicitly client
      return isAuthenticated() && (role == 'client' || role == null);
    }
    
    // Permissions check
    function canDeletePayments() {
      let user = getUserData();
      return isAuthenticated() && user != null && user.keys().hasAll(['permissions']) && user.permissions.keys().hasAll(['can_delete_payments']) && user.permissions.can_delete_payments == true;
    }

    // Entity Ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Since many documents store the client's auto-generated document ID in `clientId` or `memberId`,
    // we need a helper to verify if the requesting user actually owns that client profile.
    function ownsClientProfile(clientId) {
      let clientDoc = get(/databases/$(database)/documents/clients/$(clientId));
      return clientDoc != null && clientDoc.data.portalUserId == request.auth.uid;
    }


    // ========================================================================
    // COLLECTION RULES
    // ========================================================================
    
    // PUBLIC READ (Only Announcements)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isManager();
    }
    
    // USERS (Staff and client portal accounts)
    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow write: if isManager(); // Self-registration usually done via Cloud Functions or Admin SDK
    }
    
    // SETTINGS (Tenant configuration)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    // AUDIT LOGS (Immutable)
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false; // NOBODY can modify audit logs
    }
    
    // CLIENTS (Member Profiles)
    match /clients/{clientId} {
      // A client can read their own profile (either by uid matching clientId, or portalUserId matching)
      allow read: if isOwner(clientId) || (isAuthenticated() && resource.data.portalUserId == request.auth.uid) || isStaff();
      allow create: if isStaff();
      allow update: if isStaff() || isOwner(clientId) || (isAuthenticated() && resource.data.portalUserId == request.auth.uid);
      allow delete: if isManager();
    }
    
    // PAYMENTS (Financial Transactions)
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && ownsClientProfile(resource.data.clientId));
      allow create: if isStaff();
      allow update: if isManager();
      allow delete: if canDeletePayments() || isSuperAdmin();
    }
    
    // PACKAGES (Product Definitions)
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    // ENTITLEMENTS (Service Entitlements)
    match /entitlements/{entitlementId} {
      allow read: if isStaff() || (isAuthenticated() && ownsClientProfile(resource.data.clientId));
      allow write: if isStaff();
    }

    match /entitlements/{entitlementId}/adjustments/{adjustmentId} {
      allow read: if isStaff() || (isAuthenticated() && ownsClientProfile(get(/databases/$(database)/documents/entitlements/$(entitlementId)).data.clientId));
      allow write: if isStaff();
    }
    
    // COACHES (Coach Profiles)
    match /coaches/{coachId} {
      allow read: if isAuthenticated();
      allow update: if isOwner(coachId) || (isAuthenticated() && resource.data.portalUserId == request.auth.uid) || isManager();
      allow create, delete: if isManager();
    }

    // PAYOUT CONFIGS (Coach Payout Rates)
    match /payoutConfigs/{coachId} {
      allow read: if isAuthenticated() && (request.auth.uid == coachId || isStaff());
      allow write: if isManager();
    }

    // APPROVAL REQUESTS (Approval Workflows)
    match /approvalRequests/{requestId} {
      allow create: if isAuthenticated();
      allow read, update: if isManager() || (isAuthenticated() && resource.data.requesterId == request.auth.uid);
      allow delete: if isManager();
    }

    // PAYOUT RECORDS (Coach Earnings)
    match /payoutRecords/{recordId} {
      // Coach can read their own payout records, staff can read all
      allow read: if isAuthenticated() && (resource.data.coachId == request.auth.uid || isStaff());
      allow write: if isManager();
    }

    // COACH SCHEDULES
    match /coachSchedules/{coachId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(coachId) || (isAuthenticated() && get(/databases/$(database)/documents/coaches/$(coachId)).data.portalUserId == request.auth.uid) || isManager();
    }
    
    // SESSIONS (PT Sessions)
    match /sessions/{sessionId} {
      allow read: if isManager() || 
                     (isCoach() && (resource.data.coachId == request.auth.uid || resource.data.trainerId == request.auth.uid)) || 
                     (isClient() && ownsClientProfile(resource.data.clientId)) ||
                     isStaff();
      allow create: if isStaff() || (isClient() && ownsClientProfile(request.resource.data.clientId));
      allow update: if isStaff() || (isClient() && ownsClientProfile(resource.data.clientId));
      allow delete: if isManager();
    }
    
    // CLASS SCHEDULES (Class Definitions)
    match /classSchedules/{classId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || (isStaff() && !isCoach());
    }
    
    // CLASS BOOKINGS (Class Reservations)
    match /classBookings/{bookingId} {
      allow read: if isStaff() || (isAuthenticated() && ownsClientProfile(resource.data.clientId));
      allow create, update: if isStaff() || (isClient() && ownsClientProfile(request.resource.data.clientId));
      allow delete: if isStaff();
    }
    
    // NUTRITION APPOINTMENTS
    match /nutritionAppointments/{appointmentId} {
      allow read: if isManager() || 
                     (isStaff() && resource.data.nutritionistId == request.auth.uid) || 
                     (isClient() && ownsClientProfile(resource.data.clientId));
      allow create, update: if isStaff() || (isClient() && ownsClientProfile(request.resource.data.clientId));
      allow delete: if isManager();
    }
    
    // NUTRITION CONSULTATION NOTES (Private)
    match /nutritionAppointments/{appointmentId}/notes/{noteId} {
      allow read, write: if isStaff(); // Clients CANNOT read notes
    }
    
    // ATTENDANCE (Check-in Records)
    match /attendance/{attendanceId} {
      allow read: if isStaff() || (isAuthenticated() && ownsClientProfile(resource.data.clientId));
      allow create: if isStaff();
      allow update, delete: if isManager();
    }
    
    // TASKS (Task Assignments)
    match /tasks/{taskId} {
      allow read: if isManager() || (isAuthenticated() && (resource.data.assignedTo == request.auth.uid || resource.data.createdBy == request.auth.uid));
      allow write: if isManager() || (isAuthenticated() && (resource.data.assignedTo == request.auth.uid || resource.data.createdBy == request.auth.uid));
    }
    
    // COMPLAINTS (Tickets)
    match /complaints/{complaintId} {
      allow read: if isStaff() || (isAuthenticated() && ownsClientProfile(resource.data.clientId));
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && ownsClientProfile(resource.data.clientId));
      allow delete: if isManager();
    }
    
    // LOST & FOUND
    match /lostFoundItems/{itemId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
