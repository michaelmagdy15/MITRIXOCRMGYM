{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {},
    "production-strike": {
      "extends": "production",
      "env": {
        "GYM_SUBDOMAIN": "strike",
        "APP_NAME": "STRIKE",
        "PRODUCTION_URL": "https://strike-egy.com"
      }
    },
    "production-strikeboxing": {
      "extends": "production",
      "env": {
        "GYM_SUBDOMAIN": "strikeboxing",
        "APP_NAME": "STRIKE",
        "PRODUCTION_URL": "https://strike-egy.com"
      }
    },
    "production-inzanathletics": {
      "extends": "production",
      "env": {
        "APP_TENANT": "inzanathletics",
        "GYM_SUBDOMAIN": "inzanathletics",
        "APP_NAME": "INZAN Athletics",
        "PRODUCTION_URL": "https://admin.inzanathletics.com"
      }
    },
    "preview-inzanathletics": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_TENANT": "inzanathletics",
        "GYM_SUBDOMAIN": "inzanathletics",
        "APP_NAME": "INZAN Athletics",
        "PRODUCTION_URL": "https://admin.inzanathletics.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6782686771"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "production-strike": {
      "extends": "production"
    },
    "production-inzanathletics": {
      "extends": "production"
    }
  }
}
